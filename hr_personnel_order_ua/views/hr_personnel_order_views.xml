<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_personnel_order_search" model="ir.ui.view">
        <field name="name">hr.personnel.order.search</field>
        <field name="model">hr.personnel.order</field>
        <field name="arch" type="xml">
            <search string="Кадрові накази">
                <field name="number"/>
                <field name="subject"/>
                <field name="order_type"/>
                <field name="order_date"/>
                <field name="company_id"/>
                <field name="responsible_user_id"/>
                <filter name="draft" string="Чернетки" domain="[('state', '=', 'draft')]"/>
                <filter name="to_approve" string="На погодженні" domain="[('state', '=', 'submitted')]"/>
                <filter name="posted" string="Проведені" domain="[('state', '=', 'posted')]"/>
                <separator/>
                <filter name="group_type" string="Тип" context="{'group_by': 'order_type'}"/>
                <filter name="group_state" string="Статус" context="{'group_by': 'state'}"/>
                <filter name="group_date" string="Дата" context="{'group_by': 'order_date:month'}"/>
            </search>
        </field>
    </record>

    <record id="view_hr_personnel_order_list" model="ir.ui.view">
        <field name="name">hr.personnel.order.list</field>
        <field name="model">hr.personnel.order</field>
        <field name="arch" type="xml">
            <list string="Кадрові накази" default_order="order_date desc, id desc">
                <field name="order_date"/>
                <field name="number"/>
                <field name="order_type"/>
                <field name="subject"/>
                <field name="line_count"/>
                <field name="responsible_user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_hr_personnel_order_form" model="ir.ui.view">
        <field name="name">hr.personnel.order.form</field>
        <field name="model">hr.personnel.order</field>
        <field name="arch" type="xml">
            <form string="Кадровий наказ">
                <header>
                    <button name="action_submit" type="object" string="На погодження"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Погодити"
                            class="btn-primary" groups="hr.group_hr_manager"
                            invisible="state != 'submitted'"/>
                    <button name="action_sign" type="object" string="Позначити підписаним"
                            class="btn-primary" groups="hr.group_hr_manager"
                            invisible="state != 'approved'"/>
                    <button name="action_post" type="object" string="Провести"
                            class="btn-primary" groups="hr.group_hr_manager"
                            invisible="state != 'signed'"/>
                    <button name="action_cancel" type="object" string="Скасувати"
                            groups="hr.group_hr_manager"
                            invisible="state not in ['draft', 'submitted', 'approved', 'signed']"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Повернути в чернетку"
                            groups="hr.group_hr_manager"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,signed,posted,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_events" type="object"
                                class="oe_stat_button" icon="fa-history"
                                invisible="event_count == 0">
                            <field name="event_count" widget="statinfo"
                                   string="Кадрові події"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Проведено"
                            bg_color="text-bg-success" invisible="state != 'posted'"/>
                    <widget name="web_ribbon" title="Скасовано"
                            bg_color="text-bg-danger" invisible="state != 'cancelled'"/>

                    <div class="oe_title">
                        <label for="number"/>
                        <h1>
                            <field name="number"
                                   readonly="state in ['posted', 'cancelled']"/>
                        </h1>
                        <h2>
                            <field name="subject"
                                   placeholder="Наприклад: Про прийняття на роботу"
                                   readonly="state in ['posted', 'cancelled']"/>
                        </h2>
                    </div>

                    <group>
                        <group>
                            <field name="order_date"
                                   readonly="state in ['posted', 'cancelled']"/>
                            <field name="order_type" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state in ['posted', 'cancelled']"/>
                        </group>
                        <group>
                            <field name="responsible_user_id"
                                   widget="many2one_avatar_user"
                                   readonly="state in ['posted', 'cancelled']"/>
                            <field name="signer_id"
                                   readonly="state in ['posted', 'cancelled']"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Працівники / кадрові дії" name="lines">
                            <field name="line_ids"
                                   readonly="state in ['posted', 'cancelled']"
                                   context="{'default_effective_date': order_date}">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="order_type" column_invisible="True"/>
                                    <field name="employee_id"/>
                                    <field name="employee_name"
                                           column_invisible="parent.order_type != 'hire'"/>
                                    <field name="employee_identification_id"
                                           optional="show"/>
                                    <field name="effective_date"/>
                                    <field name="department_id"
                                           column_invisible="parent.order_type not in ['hire', 'transfer', 'department_change', 'position_change', 'employment_condition_change']"/>
                                    <field name="job_id"
                                           column_invisible="parent.order_type not in ['hire', 'transfer', 'position_change', 'department_change', 'employment_condition_change']"/>
                                    <field name="wage"
                                           column_invisible="parent.order_type not in ['hire', 'transfer', 'salary_change', 'employment_condition_change']"/>
                                    <field name="leave_type_id"
                                           column_invisible="parent.order_type != 'leave'"/>
                                    <field name="leave_date_from"
                                           column_invisible="parent.order_type != 'leave'"/>
                                    <field name="leave_date_to"
                                           column_invisible="parent.order_type != 'leave'"/>
                                    <field name="departure_reason_id"
                                           column_invisible="parent.order_type != 'termination'"/>
                                    <field name="application_state" readonly="1"/>
                                </list>
                                <form string="Кадрова дія">
                                    <field name="order_type" invisible="1"/>
                                    <field name="company_id" invisible="1"/>
                                    <field name="currency_id" invisible="1"/>
                                    <group>
                                        <group>
                                            <field name="employee_id"/>
                                            <field name="employee_name"
                                                   invisible="order_type != 'hire'"/>
                                            <field name="employee_identification_id"/>
                                        </group>
                                        <group>
                                            <field name="effective_date"/>
                                            <field name="application_state" readonly="1"/>
                                        </group>
                                    </group>

                                    <notebook>
                                        <page string="Умови праці"
                                              invisible="order_type not in ['hire', 'transfer', 'position_change', 'department_change', 'salary_change', 'schedule_change', 'employment_condition_change']">
                                            <group>
                                                <group string="Було">
                                                    <field name="previous_department_id" readonly="1"/>
                                                    <field name="previous_job_id" readonly="1"/>
                                                    <field name="previous_resource_calendar_id" readonly="1"/>
                                                    <field name="previous_wage" readonly="1"/>
                                                </group>
                                                <group string="Стало">
                                                    <field name="department_id"/>
                                                    <field name="job_id"/>
                                                    <field name="professional_category_id"/>
                                                    <field name="resource_calendar_id"/>
                                                    <field name="wage"/>
                                                </group>
                                            </group>
                                            <group string="Умови">
                                                <field name="employment_end_date"/>
                                                <field name="work_type"/>
                                                <field name="hire_condition"/>
                                                <field name="probation_months"/>
                                                <field name="trial_date_end"/>
                                                <field name="weekly_hours"/>
                                                <field name="work_conditions"/>
                                                <field name="allowance_note"/>
                                            </group>
                                        </page>

                                        <page string="Відпустка"
                                              invisible="order_type != 'leave'">
                                            <group>
                                                <field name="leave_type_id"/>
                                                <field name="work_period_from"/>
                                                <field name="work_period_to"/>
                                                <field name="leave_date_from"/>
                                                <field name="leave_date_to"/>
                                                <field name="health_assistance"/>
                                                <field name="leave_id" readonly="1"/>
                                            </group>
                                        </page>

                                        <page string="Звільнення"
                                              invisible="order_type != 'termination'">
                                            <group>
                                                <field name="departure_reason_id"/>
                                                <field name="legal_reason"/>
                                                <field name="legal_article"/>
                                                <field name="termination_basis"/>
                                                <field name="basis_document_number"/>
                                                <field name="basis_document_date"/>
                                                <field name="unused_leave_days"/>
                                                <field name="severance_amount"/>
                                            </group>
                                        </page>

                                        <page string="Системні зв'язки">
                                            <group>
                                                <field name="contract_id" readonly="1"/>
                                                <field name="leave_id" readonly="1"/>
                                            </group>
                                            <field name="note"/>
                                        </page>
                                    </notebook>
                                </form>
                            </field>
                        </page>

                        <page string="Підстава та примітки" name="basis">
                            <group>
                                <field name="basis"
                                       readonly="state in ['posted', 'cancelled']"/>
                                <field name="note"
                                       readonly="state in ['posted', 'cancelled']"/>
                                <field name="cancellation_reason"
                                       invisible="state != 'cancelled'"/>
                            </group>
                        </page>

                        <page string="Аудит" name="audit">
                            <group>
                                <group>
                                    <field name="submitted_at"/>
                                    <field name="submitted_by_id"/>
                                    <field name="approved_at"/>
                                    <field name="approved_by_id"/>
                                </group>
                                <group>
                                    <field name="signed_at"/>
                                    <field name="signed_by_id"/>
                                    <field name="posted_at"/>
                                    <field name="posted_by_id"/>
                                    <field name="cancelled_at"/>
                                    <field name="cancelled_by_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_hr_personnel_order" model="ir.actions.act_window">
        <field name="name">Кадрові накази</field>
        <field name="res_model">hr.personnel.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_personnel_order_search"/>
    </record>
</odoo>
