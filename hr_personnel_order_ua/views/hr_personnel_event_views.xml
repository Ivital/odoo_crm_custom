<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_personnel_event_search" model="ir.ui.view">
        <field name="name">hr.personnel.event.search</field>
        <field name="model">hr.personnel.event</field>
        <field name="arch" type="xml">
            <search string="Кадрова історія">
                <field name="employee_id"/>
                <field name="order_id"/>
                <field name="event_type"/>
                <field name="effective_date"/>
                <filter name="planned" string="Заплановані" domain="[('status', '=', 'planned')]"/>
                <filter name="applied" string="Застосовані" domain="[('status', '=', 'applied')]"/>
                <separator/>
                <filter name="group_employee" string="Працівник" context="{'group_by': 'employee_id'}"/>
                <filter name="group_type" string="Тип" context="{'group_by': 'event_type'}"/>
                <filter name="group_date" string="Дата" context="{'group_by': 'effective_date:year'}"/>
            </search>
        </field>
    </record>

    <record id="view_hr_personnel_event_list" model="ir.ui.view">
        <field name="name">hr.personnel.event.list</field>
        <field name="model">hr.personnel.event</field>
        <field name="arch" type="xml">
            <list string="Кадрова історія" create="0" edit="0" delete="0"
                  default_order="effective_date desc, id desc">
                <field name="effective_date"/>
                <field name="employee_id"/>
                <field name="event_type"/>
                <field name="name"/>
                <field name="order_id"/>
                <field name="status" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_hr_personnel_event_form" model="ir.ui.view">
        <field name="name">hr.personnel.event.form</field>
        <field name="model">hr.personnel.event</field>
        <field name="arch" type="xml">
            <form string="Кадрова подія" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="effective_date"/><field name="employee_id"/>
                            <field name="event_type"/><field name="status"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="order_id"/><field name="order_line_id"/>
                            <field name="contract_id"/><field name="leave_id"/>
                        </group>
                    </group>
                    <group string="Зміна кадрового стану">
                        <group string="Було">
                            <field name="previous_department_id"/>
                            <field name="previous_job_id"/>
                            <field name="previous_resource_calendar_id"/>
                            <field name="previous_wage"/>
                        </group>
                        <group string="Стало">
                            <field name="new_department_id"/>
                            <field name="new_job_id"/>
                            <field name="new_resource_calendar_id"/>
                            <field name="new_wage"/>
                            <field name="professional_category_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Умови праці">
                            <group>
                                <field name="work_type"/><field name="hire_condition"/>
                                <field name="weekly_hours"/>
                                <field name="work_conditions"/>
                                <field name="allowance_note"/>
                            </group>
                        </page>
                        <page string="Відпустка" invisible="event_type != 'leave'">
                            <group>
                                <field name="leave_type_id"/>
                                <field name="work_period_from"/><field name="work_period_to"/>
                                <field name="leave_date_from"/><field name="leave_date_to"/>
                                <field name="leave_calendar_days"/>
                                <field name="health_assistance"/>
                            </group>
                        </page>
                        <page string="Звільнення" invisible="event_type != 'termination'">
                            <group>
                                <field name="departure_reason_id"/>
                                <field name="legal_reason"/><field name="legal_article"/>
                                <field name="termination_basis"/>
                                <field name="basis_document_number"/><field name="basis_document_date"/>
                                <field name="unused_leave_days"/><field name="severance_amount"/>
                            </group>
                        </page>
                        <page string="Деталі"><field name="description"/></page>
                    </notebook>
                    <group>
                        <group><field name="applied_at"/><field name="applied_by_id"/></group>
                        <group><field name="reversed_at"/><field name="reversed_by_id"/></group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_personnel_event" model="ir.actions.act_window">
        <field name="name">Кадрова історія</field>
        <field name="res_model">hr.personnel.event</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_personnel_event_search"/>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
