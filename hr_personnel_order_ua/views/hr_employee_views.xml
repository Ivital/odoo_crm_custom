<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_personnel_order_ua" model="ir.ui.view">
        <field name="name">hr.employee.form.personnel.order.ua</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='study_field']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='study_school']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//notebook/page[@name='personal_information']" position="before">
                <page name="l10n_ua_education"
                      string="Освіта"
                      groups="hr.group_hr_user">
                    <field name="l10n_ua_education_ids"
                           nolabel="1"
                           context="{'default_employee_id': id}">
                        <list editable="bottom"
                              default_order="sequence, graduation_year, id">
                            <field name="sequence" widget="handle"/>
                            <field name="education_level"/>
                            <field name="institution_name"/>
                            <field name="specialty" optional="show"/>
                            <field name="qualification" optional="show"/>
                            <field name="document_type" optional="show"/>
                            <field name="document_series" optional="show"/>
                            <field name="document_number" optional="show"/>
                            <field name="graduation_year" optional="show"/>
                            <field name="study_form" optional="hide"/>
                            <field name="issue_date" optional="hide"/>
                        </list>
                        <form string="Освіта працівника">
                            <sheet>
                                <group>
                                    <group>
                                        <field name="sequence"/>
                                        <field name="education_level"/>
                                        <field name="institution_name"/>
                                        <field name="specialty"/>
                                        <field name="qualification"/>
                                        <field name="study_form"/>
                                    </group>
                                    <group>
                                        <field name="document_type"/>
                                        <field name="document_series"/>
                                        <field name="document_number"/>
                                        <field name="issue_date"/>
                                        <field name="graduation_year"/>
                                    </group>
                                </group>
                                <group>
                                    <field name="note"/>
                                    <field name="source" readonly="1"/>
                                    <field name="source_reference" readonly="1"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_personnel_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        groups="hr.group_hr_user">
                    <field name="personnel_order_count"
                           widget="statinfo"
                           string="Кадрові накази"/>
                </button>
                <button name="action_view_personnel_events"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-history"
                        groups="hr.group_hr_user">
                    <field name="personnel_event_count"
                           widget="statinfo"
                           string="Кадрова історія"/>
                </button>
            </xpath>

            <xpath expr="//notebook/page[@name='personal_information']" position="before">
                <page name="l10n_ua_personnel_data"
                      string="Кадрові дані"
                      groups="hr.group_hr_user">
                    <group>
                        <group string="Поточний трудовий стан">
                            <field name="identification_id"
                                   string="Поточний табельний номер"/>
                            <field name="service_hire_date"
                                   string="Дата поточного прийняття"/>
                            <field name="l10n_ua_current_personnel_number"/>
                            <field name="department_id"/>
                            <field name="job_id"/>
                            <field name="resource_calendar_id"/>
                            <field name="l10n_ua_current_work_type"/>
                            <field name="l10n_ua_current_hire_condition"/>
                            <field name="l10n_ua_current_weekly_hours"/>
                        </group>
                        <group string="Поточний контракт">
                            <field name="l10n_ua_current_contract_id"/>
                            <field name="l10n_ua_current_contract_date_start"/>
                            <field name="l10n_ua_current_contract_date_end"/>
                            <field name="l10n_ua_current_trial_date_end"/>
                            <field name="l10n_ua_current_professional_category_id"/>
                            <field name="l10n_ua_current_wage"/>
                            <field name="l10n_ua_current_order_id"/>
                        </group>
                    </group>
                    <group string="Умови праці">
                        <field name="l10n_ua_current_work_conditions"/>
                        <field name="l10n_ua_current_allowance_note"/>
                    </group>

                    <group string="Історія трудових періодів"
                           col="1">
                        <field name="l10n_ua_first_employment_date"/>

                        <field name="l10n_ua_employment_period_ids"
                               string="Фактичні трудові періоди"
                               nolabel="1"
                               readonly="1">
                            <list create="0"
                                  edit="0"
                                  delete="0"
                                  default_order="date_start asc, first_observed_date asc, id asc">
                                <field name="date_start"/>
                                <field name="date_end"/>
                                <field name="boundary_state"
                                       widget="badge"/>
                                <field name="personnel_number"/>
                                <field name="first_observed_date"
                                       optional="hide"/>
                                <field name="start_order_line_id"
                                       optional="show"/>
                                <field name="end_order_line_id"
                                       optional="show"/>
                                <field name="origin_order_line_id"
                                       optional="hide"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
