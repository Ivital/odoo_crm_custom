<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_personnel_order_ua" model="ir.ui.view">
        <field name="name">hr.employee.form.personnel.order.ua</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_personnel_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        groups="hr.group_hr_user">
                    <field name="personnel_order_count"
                           widget="statinfo"
                           string="Кадрові накази"/>
                </button>
                <button name="action_view_personnel_events"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-history"
                        groups="hr.group_hr_user">
                    <field name="personnel_event_count"
                           widget="statinfo"
                           string="Кадрова історія"/>
                </button>
            </xpath>

            <xpath expr="//notebook/page[@name='personal_information']" position="before">
                <page name="l10n_ua_personnel_data"
                      string="Кадрові дані"
                      groups="hr.group_hr_user">
                    <group>
                        <group string="Поточний трудовий стан">
                            <field name="identification_id" string="Табельний номер"/>
                            <field name="service_hire_date" string="Дата прийняття"/>
                            <field name="department_id"/>
                            <field name="job_id"/>
                            <field name="resource_calendar_id"/>
                            <field name="l10n_ua_current_work_type"/>
                            <field name="l10n_ua_current_hire_condition"/>
                            <field name="l10n_ua_current_weekly_hours"/>
                        </group>
                        <group string="Поточний контракт">
                            <field name="l10n_ua_current_contract_id"/>
                            <field name="l10n_ua_current_contract_date_start"/>
                            <field name="l10n_ua_current_contract_date_end"/>
                            <field name="l10n_ua_current_trial_date_end"/>
                            <field name="l10n_ua_current_professional_category_id"/>
                            <field name="l10n_ua_current_wage"/>
                            <field name="l10n_ua_current_order_id"/>
                        </group>
                    </group>
                    <group string="Умови праці">
                        <field name="l10n_ua_current_work_conditions"/>
                        <field name="l10n_ua_current_allowance_note"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
