<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_personnel_order_company_rule" model="ir.rule">
        <field name="name">Кадрові накази: підприємства користувача</field>
        <field name="model_id" ref="model_hr_personnel_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>
    <record id="hr_personnel_order_line_company_rule" model="ir.rule">
        <field name="name">Рядки кадрових наказів: підприємства користувача</field>
        <field name="model_id" ref="model_hr_personnel_order_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>
    <record id="hr_personnel_event_company_rule" model="ir.rule">
        <field name="name">Кадрові події: підприємства користувача</field>
        <field name="model_id" ref="model_hr_personnel_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>
</odoo>
