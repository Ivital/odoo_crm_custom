<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_hr_personnel_a4_portrait" model="report.paperformat">
        <field name="name">Кадрові форми — A4 книжкова</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">7</field>
        <field name="margin_bottom">7</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="paperformat_hr_personnel_a4_landscape" model="report.paperformat">
        <field name="name">Кадрові форми — A4 альбомна</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">6</field>
        <field name="margin_bottom">6</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_personnel_order_p1" model="ir.actions.report">
        <field name="name">Типова форма П-1</field>
        <field name="model">hr.personnel.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_personnel_order_ua.report_personnel_order_p1</field>
        <field name="report_file">hr_personnel_order_ua.report_personnel_order_p1</field>
        <field name="paperformat_id" ref="paperformat_hr_personnel_a4_portrait"/>
        <field name="print_report_name">'П-1 - %s' % (object.number or '')</field>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_personnel_order_p3" model="ir.actions.report">
        <field name="name">Типова форма П-3</field>
        <field name="model">hr.personnel.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_personnel_order_ua.report_personnel_order_p3</field>
        <field name="report_file">hr_personnel_order_ua.report_personnel_order_p3</field>
        <field name="paperformat_id" ref="paperformat_hr_personnel_a4_portrait"/>
        <field name="print_report_name">'П-3 - %s' % (object.number or '')</field>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_personnel_order_p4" model="ir.actions.report">
        <field name="name">Типова форма П-4</field>
        <field name="model">hr.personnel.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_personnel_order_ua.report_personnel_order_p4</field>
        <field name="report_file">hr_personnel_order_ua.report_personnel_order_p4</field>
        <field name="paperformat_id" ref="paperformat_hr_personnel_a4_portrait"/>
        <field name="print_report_name">'П-4 - %s' % (object.number or '')</field>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_personal_card_p2" model="ir.actions.report">
        <field name="name">Особова картка П-2</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_personnel_order_ua.report_personal_card_p2</field>
        <field name="report_file">hr_personnel_order_ua.report_personal_card_p2</field>
        <field name="paperformat_id" ref="paperformat_hr_personnel_a4_landscape"/>
        <field name="print_report_name">'П-2 - %s' % (object.name or '')</field>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
