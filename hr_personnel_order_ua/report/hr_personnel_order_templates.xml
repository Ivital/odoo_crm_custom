                        </div>
                        <div style="margin-top:10px;">
                            <span class="l10n-ua-checkbox" style="display:inline-block; width:10px; height:10px; line-height:9px; border:1px solid #000; text-align:center; vertical-align:middle; font-family:'Times New Roman'; font-size:8pt; font-weight:bold;" t-esc="'X' if line.health_assistance else ''"/>
