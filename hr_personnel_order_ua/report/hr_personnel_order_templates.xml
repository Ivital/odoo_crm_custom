    <template id="report_personnel_order_p4">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="order">
                <div class="article"
                     t-foreach="order.line_ids"
                     t-as="line"
                     t-att-data-oe-model="order._name"
                     t-att-data-oe-id="order.id"
                     t-att-data-oe-lang="order.env.context.get('lang')">
                    <t t-set="company" t-value="order.company_id"/>
                    <t t-set="signer_name"
                       t-value="order.signer_id.name or company.l10n_ua_manager_partner_id.name or ''"/>
                    <t t-set="severance_text"
                       t-value="'%.2f' % (line.severance_amount or 0.0)"/>

                    <div class="page"
                         style="font-family:'Times New Roman'; font-size:10.5pt; line-height:1.28;">

                        <table style="width:100%; border-collapse:collapse;">
                            <tr>
                                <td style="width:60%; vertical-align:top;">
                                    <div style="border-bottom:1px solid #000; min-height:18px;">
                                        <strong t-esc="company.name"/>
                                    </div>
                                    <div style="font-size:8pt; text-align:center;">
                                        Найменування підприємства (установи, організації)
                                    </div>
                                </td>

                                <td style="width:40%; vertical-align:top; padding-left:14px;">
                                    <strong>Типова форма № П-4</strong><br/>
                                    ЗАТВЕРДЖЕНО<br/>
                                    Наказ Держкомстату України<br/>
                                    05.12.2008 № 489
                                </td>
                            </tr>
                        </table>

                        <table style="width:44%; margin-left:auto; margin-top:10px; border-collapse:collapse;">
                            <tr>
                                <td style="border:1px solid #000; padding:3px;">
                                    Код ЄДРПОУ
                                </td>
                                <td style="border:1px solid #000; padding:3px; text-align:center;">
                                    <span t-esc="company.company_registry or ''"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="border:1px solid #000; padding:3px;">
                                    Дата складання
                                </td>
                                <td style="border:1px solid #000; padding:3px; text-align:center;">
                                    <span t-esc="order.order_date.strftime('%d.%m.%Y') if order.order_date else ''"/>
                                </td>
                            </tr>
                        </table>

                        <div style="text-align:center; margin-top:22px;">
                            <div style="font-size:14pt; font-weight:bold;">
                                НАКАЗ № <span t-esc="order.number"/>
                            </div>
                            <div style="font-weight:bold;">
                                (РОЗПОРЯДЖЕННЯ)
                            </div>
                            <div style="font-size:11pt; font-weight:bold; margin-top:5px;">
                                про припинення трудового договору (контракту)
                            </div>
                        </div>

                        <div style="margin-top:18px; font-size:11pt;">
                            Звільнити
                            <strong t-esc="line.effective_date.strftime('%d.%m.%Y') if line.effective_date else ''"/>
                        </div>

                        <table style="width:100%; margin-top:10px; border-collapse:collapse;">
                            <tr>
                                <td style="width:76%; border-bottom:1px solid #000;">
                                    <strong t-esc="line.employee_id.name or line.employee_name or ''"/>
                                </td>
                                <td style="width:24%; padding-left:12px;">
                                    <div style="text-align:center;">
                                        Табельний номер
                                    </div>
                                    <div style="border:1px solid #000; padding:3px; text-align:center;">
                                        <strong t-esc="line.employee_id.identification_id or line.employee_identification_id or ''"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <div style="font-size:8pt; width:76%; text-align:center;">
                            (прізвище, ім’я, по батькові)
                        </div>

                        <div style="margin-top:9px; border-bottom:1px solid #000; min-height:19px;">
                            <span t-esc="line.employee_id.department_id.name or line.department_id.name or ''"/>
                        </div>
                        <div style="font-size:8pt; text-align:center;">
                            назва структурного підрозділу
                        </div>

                        <div style="margin-top:7px; border-bottom:1px solid #000; min-height:19px;">
                            <span t-esc="line.employee_id.job_id.name or line.job_id.name or ''"/>
                            <t t-if="line.professional_category_id">
                                , <span t-esc="line.professional_category_id.name"/>
                            </t>
                        </div>
                        <div style="font-size:8pt; text-align:center;">
                            назва професії (посади), розряд, клас (категорія) кваліфікації
                        </div>

                        <div style="margin-top:9px; border-bottom:1px solid #000; min-height:19px;">
                            <span t-esc="(line.legal_reason or (line.departure_reason_id.name if line.departure_reason_id else '')) + ((', ' + line.legal_article) if line.legal_article else '')"/>
                        </div>
                        <div style="font-size:8pt; text-align:center;">
                            причина звільнення
                        </div>

                        <div style="margin-top:9px; border-bottom:1px solid #000; min-height:28px;">
                            <span t-esc="line.termination_basis or ''"/>
                            <t t-if="line.basis_document_number">
                                № <span t-esc="line.basis_document_number"/>
                            </t>
                            <t t-if="line.basis_document_date">
                                від
                                <span t-esc="line.basis_document_date.strftime('%d.%m.%Y')"/>
                            </t>
                            <t t-if="order.basis">
                                <span t-esc="order.basis"/>
                            </t>
                        </div>
                        <div style="font-size:8pt; text-align:center;">
                            підстави звільнення
                        </div>

                        <div style="margin-top:19px;">
                            <span class="l10n-ua-checkbox"
                                  style="display:inline-block; width:10px; height:10px; line-height:9px; border:1px solid #000; text-align:center; vertical-align:middle; font-family:'Times New Roman'; font-size:8pt; font-weight:bold;"
                                  t-esc="'X' if line.severance_amount else ''"/>
                            Вихідна допомога
                            <span style="display:inline-block; width:105px; border-bottom:1px solid #000; text-align:center;">
                                <t t-if="line.severance_amount">
                                    <span t-esc="severance_text.split('.')[0]"/>
                                </t>
                            </span>
                            грн.
                            <span style="display:inline-block; width:50px; border-bottom:1px solid #000; text-align:center;">
                                <t t-if="line.severance_amount">
                                    <span t-esc="severance_text.split('.')[1]"/>
                                </t>
                            </span>
                            коп.
                        </div>

                        <div t-if="line.unused_leave_days"
                             style="margin-top:18px; padding-top:7px; border-top:1px solid #999; font-size:9pt;">
                            <strong>Додатково:</strong>
                            виплатити компенсацію за невикористані
                            <strong t-esc="'%g' % line.unused_leave_days"/>
                            календарних днів щорічної відпустки

                            <t t-if="line.work_period_from or line.work_period_to">
                                за період роботи
                                <strong t-esc="line.work_period_from.strftime('%d.%m.%Y') if line.work_period_from else '__________'"/>
                                -
                                <strong t-esc="line.work_period_to.strftime('%d.%m.%Y') if line.work_period_to else '__________'"/>
                            </t>
                        </div>

                        <table style="width:100%; margin-top:43px; border-collapse:collapse;">
                            <tr>
                                <td style="width:34%;">
                                    Керівник підприємства<br/>
                                    <span style="font-size:8pt;">
                                        (установи, організації)
                                    </span>
                                </td>
                                <td style="width:28%; text-align:center;">
                                    ______________<br/>
                                    <span style="font-size:8pt;">
                                        підпис
                                    </span>
                                </td>
                                <td style="width:38%; text-align:center;">
                                    <span t-esc="signer_name or '____________________________'"/>
                                </td>
                            </tr>
                        </table>

                        <table style="width:100%; margin-top:30px; border-collapse:collapse;">
                            <tr>
                                <td style="width:34%;">
                                    З наказом (розпорядженням)<br/>
                                    ознайомлений
                                </td>
                                <td style="width:28%; text-align:center;">
                                    ______________<br/>
                                    <span style="font-size:8pt;">
                                        підпис працівника
                                    </span>
                                </td>
                                <td style="width:38%; text-align:center;">
                                    «____» ____________ 20__ р.
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
