<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_personal_information_uk_employee_full"
            model="ir.ui.view">
        <field name="name">res.partner.form.uk.employee.personal.full</field>
        <field name="model">res.partner</field>
        <field name="inherit_id"
               ref="crm_uk_localization.view_partner_personal_information_uk_hr"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='ua_hr_identification']" position="after">
                <group string="Сім'я"
                       name="ua_hr_family"
                       groups="hr.group_hr_user">
                    <field name="l10n_ua_marital"/>
                    <field name="l10n_ua_spouse_complete_name"
                           invisible="l10n_ua_marital not in ('married', 'cohabitant')"/>
                    <field name="l10n_ua_spouse_birthdate"
                           invisible="l10n_ua_marital not in ('married', 'cohabitant')"/>
                    <field name="l10n_ua_children"/>
                </group>
                <group string="Освіта"
                       name="ua_hr_education"
                       groups="hr.group_hr_user">
                    <field name="l10n_ua_certificate"/>
                    <field name="l10n_ua_study_field"/>
                    <field name="l10n_ua_study_school"/>
                </group>
                <group string="Екстрений контакт"
                       name="ua_hr_emergency"
                       groups="hr.group_hr_user">
                    <field name="l10n_ua_emergency_contact"/>
                    <field name="l10n_ua_emergency_phone"/>
                </group>
                <group string="Додаткові документи"
                       name="ua_hr_additional_documents"
                       groups="hr.group_hr_user">
                    <field name="l10n_ua_ssnid"/>
                    <field name="l10n_ua_sinid"/>
                    <field name="l10n_ua_permit_no"/>
                    <field name="l10n_ua_work_permit_expiration_date"/>
                    <field name="l10n_ua_visa_no"/>
                    <field name="l10n_ua_visa_expire"/>
                </group>
                <group string="Додаткова інформація"
                       name="ua_hr_additional_note"
                       groups="hr.group_hr_user">
                    <field name="l10n_ua_additional_note" nolabel="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_uk_employee_full" model="ir.ui.view">
        <field name="name">res.partner.form.uk.employee.full</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">45</field>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/notebook" position="inside">
                <page string="Працівник"
                      name="ua_employee_full"
                      invisible="not employee_ids"
                      groups="hr.group_hr_user">
                    <group>
                        <group string="Організація">
                            <field name="l10n_ua_employee_id"
                                   readonly="1"
                                   options="{'no_create': True, 'no_open': False}"/>
                            <field name="l10n_ua_employee_active" readonly="1"/>
                            <field name="l10n_ua_employee_identification_id" readonly="1"/>
                            <field name="l10n_ua_employee_company_id" readonly="1"/>
                            <field name="l10n_ua_employee_department_id" readonly="1"/>
                            <field name="l10n_ua_employee_job_id" readonly="1"/>
                            <field name="l10n_ua_employee_job_title" readonly="1"/>
                            <field name="l10n_ua_employee_parent_id" readonly="1"/>
                            <field name="l10n_ua_employee_coach_id" readonly="1"/>
                        </group>
                        <group string="Робочі дані">
                            <field name="l10n_ua_employee_work_location_id" readonly="1"/>
                            <field name="l10n_ua_employee_work_address_id" readonly="1"/>
                            <field name="l10n_ua_employee_work_phone" readonly="1"/>
                            <field name="l10n_ua_employee_work_email" readonly="1"/>
                            <field name="l10n_ua_employee_mobile_phone" readonly="1"/>
                            <field name="l10n_ua_employee_user_id" readonly="1"/>
                            <field name="l10n_ua_employee_type" readonly="1"/>
                            <field name="l10n_ua_employee_resource_calendar_id" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <group string="Службові реквізити">
                            <field name="l10n_ua_employee_bank_account_id" readonly="1"/>
                            <field name="l10n_ua_employee_barcode" readonly="1"/>
                            <field name="l10n_ua_employee_pin" readonly="1"/>
                            <field name="l10n_ua_employee_distance_home_work" readonly="1"/>
                            <field name="l10n_ua_employee_distance_home_work_unit" readonly="1"/>
                            <field name="l10n_ua_employee_category_ids"
                                   widget="many2many_tags"
                                   readonly="1"/>
                        </group>
                        <group string="HR-нотатки">
                            <field name="l10n_ua_employee_notes"
                                   nolabel="1"
                                   readonly="1"/>
                        </group>
                    </group>

                    <separator string="Усі пов'язані картки працівника"/>
                    <field name="employee_ids" nolabel="1" readonly="1">
                        <list create="false" delete="false" edit="false">
                            <field name="active"/>
                            <field name="identification_id" string="Табельний номер"/>
                            <field name="company_id"/>
                            <field name="department_id"/>
                            <field name="job_id"/>
                            <field name="job_title"/>
                            <field name="work_email"/>
                            <field name="mobile_phone"/>
                            <field name="employee_type"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
