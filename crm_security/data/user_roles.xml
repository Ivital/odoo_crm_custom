<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Canonical business roles.

        Each OCA User Role directly implies exactly one crm_security
        business group. The crm_security group remains the canonical
        owner of the underlying Odoo/OCA security-group composition.
    -->

    <record id="role_crm_manager" model="res.users.role">
        <field name="name">CRM-менеджер</field>
        <field name="sequence">10</field>
        <field name="implied_ids"
               eval="[Command.set([ref('crm_security.group_crm_manager')])]"/>
    </record>

    <record id="role_contract_viewer" model="res.users.role">
        <field name="name">Перегляд договорів</field>
