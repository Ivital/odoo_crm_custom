<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_auditor_helpdesk_all" model="ir.rule">
        <field name="name">Auditor: all Helpdesk tickets</field>
        <field name="model_id" ref="helpdesk_mgmt.model_helpdesk_ticket"/>
        <field name="groups"
               eval="[Command.link(ref('crm_security.group_auditor'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_auditor_maintenance_all" model="ir.rule">
        <field name="name">Auditor: all Maintenance requests</field>
        <field name="model_id" ref="maintenance.model_maintenance_request"/>
        <field name="groups"
               eval="[Command.link(ref('crm_security.group_auditor'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_auditor_maintenance_equipment_all" model="ir.rule">
        <field name="name">Auditor: all Maintenance equipment</field>
        <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
        <field name="groups"
               eval="[Command.link(ref('crm_security.group_auditor'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
