
<?xml version="1.0" encoding="utf-8"?>

<odoo>



    <!-- Agreements:

         Contract User/Manager and Auditor inherit Contract Viewer. -->

    <record id="agreement_legal.agreement_legal_menu_root" model="ir.ui.menu">

        <field name="groups_id"

               eval="[Command.set([

                   ref('crm_security.group_contract_viewer'),

                   ref('base.group_system')

               ])]"/>

    </record>



    <!-- Maintenance:

         keep operational maintenance separate from generic Internal User. -->

    <record id="maintenance.menu_maintenance_title" model="ir.ui.menu">

        <field name="groups_id"

               eval="[Command.set([

                   ref('crm_security.group_maintenance_manager'),

                   ref('crm_security.group_auditor'),

                   ref('base.group_system')

               ])]"/>

    </record>



    <!-- Employees:

         remove generic base.group_user exposure but preserve real HR users. -->

    <record id="hr.menu_hr_root" model="ir.ui.menu">

        <field name="groups_id"

               eval="[Command.set([

                   ref('hr.group_hr_user'),

                   ref('hr.group_hr_manager'),

                   ref('base.group_system')

               ])]"/>

    </record>



    <!-- Apps must be administrative. -->

    <record id="base.menu_management" model="ir.ui.menu">

        <field name="groups_id"

               eval="[Command.set([

                   ref('base.group_system')

               ])]"/>

    </record>



    <!-- Generic spreadsheet dashboards:

         keep administration/configuration away from ordinary business roles. -->

    <record id="spreadsheet_dashboard.spreadsheet_dashboard_menu_root"

            model="ir.ui.menu">

        <field name="groups_id"

               eval="[Command.set([

                   ref('spreadsheet_dashboard.group_dashboard_manager'),

                   ref('base.group_system')

               ])]"/>

    </record>



    <!-- Auditor needs read-only navigation to domains for which

         crm_security already grants read ACLs. These are additive. -->



    <record id="helpdesk_mgmt.helpdesk_ticket_main_menu" model="ir.ui.menu">

        <field name="groups_id"

               eval="[Command.link(ref('crm_security.group_auditor'))]"/>

    </record>



    <record id="fieldservice.root" model="ir.ui.menu">

        <field name="groups_id"

               eval="[Command.link(ref('crm_security.group_auditor'))]"/>

    </record>



    <record id="stock.menu_stock_root" model="ir.ui.menu">

        <field name="groups_id"

               eval="[Command.link(ref('crm_security.group_auditor'))]"/>

    </record>



    <record id="repair.menu_repair_order" model="ir.ui.menu">

        <field name="groups_id"

               eval="[Command.link(ref('crm_security.group_auditor'))]"/>

    </record>



</odoo>

